meta {
  name: Login usuario
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{usuarioEmail}}",
    "password": "{{usuarioPassword}}"
  }
}

script:post-response {
if (res.status === 200) {
  const token = res.body.token || res.body.accessToken || res.body.jwt;
  bru.setEnvVar("usuarioToken", token);
}
}

tests {
  test("responde 200", function () {
    expect(res.status).to.equal(200);
  });
  test("regresa un JWT", function () {
    expect(res.body.token || res.body.accessToken || res.body.jwt).to.be.a("string");
  });
}

docs {
Inicia sesión con una cuenta ROLE_USUARIO y guarda el JWT en usuarioToken (se usa para probar el 403).
}
