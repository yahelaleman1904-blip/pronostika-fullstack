meta {
  name: Actualizar pronostico
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/pronosticos/{{pronosticoId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "partidoId": {{partidoId1}},
    "ganadorPrevisto": "Empate",
    "probabilidad": 55,
    "estado": "PENDIENTE"
  }
}

tests {
  test("responde 200", function () {
    expect(res.status).to.equal(200);
  });
}

docs {
Actualiza el ganador previsto, probabilidad o estado de un pronóstico existente.
}
