meta {
  name: Crear pronostico
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/pronosticos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "partidoId": {{partidoId1}},
    "ganadorPrevisto": "Local",
    "probabilidad": 72,
    "estado": "PENDIENTE"
  }
}

script:post-response {
if (res.status === 201 && res.body.id) {
  bru.setEnvVar("pronosticoId", res.body.id);
}
}

tests {
  test("responde 201", function () {
    expect(res.status).to.equal(201);
  });
}

docs {
Crea un nuevo pronóstico oficial. Requiere rol ADMIN o ANALISTA.
}
